pipeline
{
    agent
    {
     docker{
      image 'nidhi2425/latest-spring-boot-app-img:latest'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'

     }
    } 

    stages
    {
        stage('Checkout')
        {
          steps{
            sh 'echo Checkout done'
          }
           
        }

        stage('Build and Test')
        {
            steps{
             sh 'cd jenkins-pipeline-1/java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
            }
             
        }
        stage('Static Code Analysis')
        {
            environment{
               SONAR_URL= "http://54.175.180.216:9000" 
            }
            steps{
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')])
                {
                    sh 'cd jenkins-pipeline-1/java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn sonar:sonar -Dsonar.token=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
                }
            }
        }
        stage('Docker Build and Push')
        {
            environment{
                DOCKER_IMAGE = "nidhi2425/pipeline-1:${BUILD_NUMBER}"
                REGISTRY_CREDENTIALS = credentials ('docker_cred') 
            }
            steps{
              script{
                 sh 'cd jenkins-pipeline-1/java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
                 def dockerImage = docker.image("${DOCKER_IMAGE}")
                 docker.withRegistry('https://index.docker.io/v1/', "docker_cred")
                 {
                   dockerImage.push()

                }
            }
        }
        }
        stage('Update Deployment Manifest')
        {
            environment{
                GIT_REPO_NAME = "pro-jenkins-pipelines"
                GIT_USER_NAME = "learnandgrow459-ui"
            }
            steps{
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                       git config user.email "learnandgrow@gmail.com"
                       git config user.name "learnandgrow459-ui"
                       sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" jenkins-pipeline-1/java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                       git add jenkins-pipeline-1/java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                       git commit -m "Updated deployment image to version ${BUILD_NUMBER}"
                       git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                    '''
                    }
                 }
        }
    }
}
